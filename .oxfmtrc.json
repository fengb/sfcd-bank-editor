{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [{ "groupName": "vitest", "elementNamePattern": ["vitest"] }],
    "groups": [
      ["vitest"],
      ["builtin", "external"],
      ["internal"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
